{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend-app": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend-api": {
      "root": "backend/",
      "entrypoint": "main:app"
    },
    "ai-task": {
      "root": "task3-ai/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend-app"
      }
    }
  ]
}
