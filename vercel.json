{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend-api": {
      "root": "backend/",
      "entrypoint": "main:app"
    },
    "ai-task": {
      "root": "task3-ai/"
    },
    "frontend-app": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend-api" } },
    { "source": "/(.*)", "destination": { "service": "frontend-app" } }
  ]
}
